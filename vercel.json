{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "framework": null,
  "routes": [
    {
      "src": "^/(.*)$",
      "has": [{ "type": "host", "value": "www.sahib.sa" }],
      "status": 308,
      "headers": { "Location": "https://sahib.sa/$1" }
    },
    { "src": "^/landing\\.html$", "status": 308, "headers": { "Location": "/" } },
    { "src": "^/faq\\.html$", "status": 308, "headers": { "Location": "/help.html" } },
    {
      "src": "^/(.*)$",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://www.google.com https://www.gstatic.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.tile.openstreetmap.org; frame-src https://www.openstreetmap.org https://www.google.com https://www.recaptcha.net; connect-src 'self' https://kyvtfmmbohmxqjlnjoys.supabase.co https://www.google.com https://www.recaptcha.net https://overpass-api.de https://api.worldbank.org https://o4511949202063360.ingest.us.sentry.io; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'",
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
      },
      "continue": true
    },
    {
      "src": "^/(.*)\\.(png|jpe?g|gif|svg|webp|avif|ico)$",
      "headers": { "Cache-Control": "public, max-age=604800, stale-while-revalidate=2592000" },
      "continue": true
    },
    {
      "src": "^/(.*)\\.(pdf|xlsx|xls|docx|csv)$",
      "headers": { "Cache-Control": "public, max-age=2592000, stale-while-revalidate=31536000" },
      "continue": true
    },
    {
      "src": "^/(.*)\\.(woff2|woff|ttf|otf)$",
      "headers": { "Cache-Control": "public, max-age=31536000, stale-while-revalidate=31536000" },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/(.*)\\.(js|css)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/fonts/fonts\\.css$",
      "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" },
      "continue": true
    },
    {
      "src": "^/js/(.*)\\.js$",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    {
      "src": "^/whatsapp-config\\.js$",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    {
      "src": "^/bank-transfer-config\\.js$",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    {
      "src": "^/manifest\\.json$",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    { "src": "^/$", "dest": "/landing.html" },
    { "handle": "filesystem" },
    { "src": "^/assets/.*$", "status": 404 },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
