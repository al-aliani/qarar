# Feasibility Platform — Environment Variables (Production)
# Copy to .env and set values. Never commit .env to version control.

# Required in production (FEASIBILITY_ENV=production)
JWT_SECRET_KEY=your-super-secret-key-min-32-chars

# Optional: alternative name for the same secret
# SECRET_KEY=your-super-secret-key-min-32-chars

# Environment: development | production
# In production, JWT_SECRET_KEY must be set or the app will not start.
FEASIBILITY_ENV=development

# AI server (optional): restrict CORS in production. Default * for dev.
# ALLOWED_ORIGIN=https://your-domain.com

# Sentry (optional): مراقبة الأخطاء في الإنتاج
# احصل على DSN من https://sentry.io بعد إنشاء مشروع
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
